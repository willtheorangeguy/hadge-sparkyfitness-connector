CONNECTOR_VERSION=0.1.0
GITHUB_REPOSITORY=your-github-name/health
# Fine-grained token restricted to that repository, with Contents: Read-only.
GITHUB_TOKEN=replace-with-your-read-only-token
# Optional file-based GitHub token; takes precedence over GITHUB_TOKEN.
GITHUB_TOKEN_FILE=
GITHUB_BRANCH=

SPARKYFITNESS_URL=https://fitness.example.com
# Diary timezone; choose before the first sync and keep it with the state volume.
SPARKYFITNESS_TIMEZONE=UTC
# Create a Sparky API key allowed to write workout health data.
SPARKYFITNESS_API_KEY=replace-with-your-sparky-api-key
SPARKYFITNESS_API_KEY_FILE=

SYNC_INTERVAL_SECONDS=300
# Optional inclusive diary date in SPARKYFITNESS_TIMEZONE; blank imports all history.
EXPORT_SINCE=
